# ==================== 开发环境配置 ====================
# 复制此文件为 .env 用于开发环境
# 开发环境使用本地数据库和宽松的安全设置

# Flask 配置
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_SECRET_KEY=dev_secret_key_for_local_development_only_change_in_production
FLASK_PORT=5000
FLASK_HOST=127.0.0.1

# 数据库配置 - 开发环境使用SQLite
DATABASE_URI=sqlite:///instance/score_management.db
SQLALCHEMY_TRACK_MODIFICATIONS=false

# Redis 缓存配置 - 开发环境使用本地Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT 配置
JWT_SECRET_KEY=dev_jwt_secret_key_for_local_development_only_change_in_production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800
JWT_ALGORITHM=HS256

# 安全配置
CSRF_SECRET_KEY=dev_csrf_secret_key_here
ENABLE_HTTPS=false

# 限流配置 - 开发环境放宽限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_HOUR=5000
RATE_LIMIT_PER_MINUTE=200
RATE_LIMIT_DEFAULT=5000 per hour
RATE_LIMIT_STRICT=1000 per hour
RATE_LIMIT_BURST=100 per minute

# MQTT 配置 - 开发环境使用公共MQTT Broker
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_CLIENT_ID=score_backend_dev
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_SSL=false
MQTT_TIMEOUT=10
MQTT_KEEPALIVE=60
MQTT_TOPIC_PREFIX=score/management

# Celery 配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=2

# 备份配置
BACKUP_ENABLED=false

# CORS配置 - 开发环境允许本地前端
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

# 日志配置
LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s: %(message)s
LOG_FILE_PATH=logs/app.log

# 性能配置
PERFORMANCE_MONITOR_ENABLED=true
SLOW_REQUEST_THRESHOLD=2.0

# NLP 配置
NLP_MODEL_PATH=models/trained/
ENABLE_BERT_MODEL=true

# 开发模式
DEV_MODE=true
TEST_DATABASE_URI=sqlite:///:memory: