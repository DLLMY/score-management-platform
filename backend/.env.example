# 后端环境变量配置模板
# 复制此文件为 .env 并填写你的配置
# .env 已加入 .gitignore，不会被提交到仓库

# Flask 配置
FLASK_ENV=development
FLASK_SECRET_KEY=your_secret_key_here_change_in_production
FLASK_PORT=5000

# 数据库配置
DATABASE_URI=sqlite:///instance/score_management.db

# Redis 缓存配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MQTT 配置
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=score/management

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_MINUTE=30

# 备份配置
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_COUNT=10
