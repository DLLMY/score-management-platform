# 后端环境变量配置模板
# 复制此文件为 .env 并填写你的配置
# .env 已加入 .gitignore，不会被提交到仓库

# Flask 配置
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_SECRET_KEY=your_strong_secret_key_here_must_be_at_least_32_characters_long_for_production
FLASK_PORT=5000

# 数据库配置 - 使用相对路径时Flask会自动基于应用根目录解析
DATABASE_URI=sqlite:///instance/score_management.db

# Redis 缓存配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 安全配置
CSRF_SECRET_KEY=csrf_secret_key_here_different_from_flask_secret

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_MINUTE=30

# MQTT 配置
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_CLIENT_ID=score_backend_dev
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_SSL=false
MQTT_TIMEOUT=10
MQTT_KEEPALIVE=60
MQTT_TOPIC_PREFIX=score/management

# JWT配置
JWT_SECRET_KEY=jwt_strong_secret_key_must_be_kept_secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# 备份配置
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_COUNT=10
