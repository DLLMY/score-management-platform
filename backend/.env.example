# ============================================================
# 学生积分管理平台 - 后端环境变量模板（.env.example）
# ============================================================
# 用法：复制为 backend/.env 后按需修改
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# 一键部署（deploy/one_click_deploy.py / deploy.ps1）会自动生成 .env。
#
# 安全提示：生产环境务必修改所有 SECRET_KEY；FLASK_ENV=production 时
# 自动启用 HttpOnly cookie 的 Secure 标志（需 HTTPS）。

# ---------- Flask 基础 ----------
FLASK_APP=app
# development=调试模式（热重载/详细日志）；production=生产模式（无重载，cookie Secure）
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# 会话/CSRF 签名密钥（生产必须改为随机值，可用 secrets.token_hex(32) 生成）
FLASK_SECRET_KEY=change-me-flask-secret
CSRF_SECRET_KEY=change-me-csrf-secret

# ---------- 认证（JWT / Cookie） ----------
# JWT 签名密钥（生产必须改为随机值）
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800
# Cookie Secure 标志（HttpOnly cookie 是否仅 HTTPS 传输）。
# 默认自动按 FLASK_ENV 判断（production=True）；如需显式覆盖可取消注释：
# SESSION_COOKIE_SECURE=true
# 首次初始化管理员密码（deploy 脚本 init_admin 使用；初始化后可删除该行）
ADMIN_INIT_PASSWORD=admin123456

# ---------- 数据库 ----------
# SQLite 默认（相对 backend/ 目录）；可改为 MySQL/PostgreSQL 连接串
DATABASE_URI=sqlite:///instance/score_management.db

# ---------- Redis 缓存（可选，缺失时自动降级内存缓存） ----------
# 开发环境可自动拉起本地 Redis（生产建议 false，用独立 Redis 实例）
REDIS_AUTO_START=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- 限流 ----------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_MINUTE=30

# ---------- MQTT（设备通信） ----------
# 生产建议使用 EMQX 云实例（SSL）：nc5233fc.ala.cn-hangzhou.emqxsl.cn:8883
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_SSL=false
MQTT_CLIENT_ID=score_backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TIMEOUT=10
MQTT_KEEPALIVE=60
MQTT_TOPIC_PREFIX=score/management
# tcp=标准 MQTT；websockets=走 WebSocket 隧道（部分云 broker 仅支持）
MQTT_TRANSPORT=tcp

# ---------- OTA 固件升级策略 ----------
OTA_AUTO_PUSH_ENABLED=false
OTA_FIRMWARE_BASE_URL=
OTA_PUSH_COOLDOWN_SEC=600
OTA_QUIET_WINDOWS=
OTA_RESPECT_CLASS_TIME=true
OTA_ROLLOUT_JITTER_SEC=30
OTA_SIGNING_SECRET=
OTA_STAGED_ROLLOUT=false
OTA_STAGE_BATCH_INTERVAL_SEC=60
OTA_STAGE_BATCH_SIZE=10
OTA_STAGE_PERCENT=20

# ---------- 备份 ----------
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_COUNT=10

# ---------- CORS ----------
# 前端地址列表（逗号分隔）；生产同域部署可保持默认
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Celery（可选后台任务，生产建议启用） ----------
START_CELERY=0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=4

# ---------- 日志与 Gunicorn（Linux 生产部署） ----------
LOG_LEVEL=INFO
GUNICORN_WORKER_CLASS=gevent
