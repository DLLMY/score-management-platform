# ngrok配置文件模板
# 
# 安全说明：
# - 请勿在此文件中填写authtoken
# - authtoken应通过一键部署脚本交互式配置
# - authtoken会保存到系统配置文件，不会上传到仓库
#
# 使用方法：
# 1. 运行一键部署脚本: deploy\一键部署.bat
# 2. 选择 "1. Yes - Configure ngrok authtoken now"
# 3. 输入您的authtoken（从 https://dashboard.ngrok.com/get-started/your-authtoken 获取）
# 4. authtoken将保存到系统配置文件: C:\Users\<用户名>\AppData\Local\ngrok\ngrok.yml

version: "3"

agent:
    connect_url: connect.us.ngrok-agent.com:443

tunnels:
    proxy:
        proto: http
        addr: 3001
        host_header: localhost:3001

# 配置说明：
# - proxy: 隧道名称，一键部署脚本使用此名称启动
# - addr: 代理服务器端口（3001）
# - host_header: 主机头，确保正确路由
# 
# 架构说明：
#   外网用户 → ngrok → proxy-server(3001) → frontend(3000)/backend(5000)
