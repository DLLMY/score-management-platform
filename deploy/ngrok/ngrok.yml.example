# ngrok配置文件
# 
# 使用说明：
# 1. authtoken 不存储在此文件中，通过命令行配置
# 2. 运行一键部署脚本时，选择 "Configure ngrok authtoken" 选项
# 3. 或手动运行: ngrok config add-authtoken <your-authtoken>
# 4. 从 https://dashboard.ngrok.com/get-started/your-authtoken 获取authtoken

version: "3"

agent:
    connect_url: connect.us.ngrok-agent.com:443

tunnels:
    proxy:
        proto: http
        addr: 3001
        host_header: localhost:3001
        pooling_enabled: true
        websocket: true

# 配置说明：
# - proxy: 隧道名称，一键部署脚本使用此名称启动
# - addr: 代理服务器端口（3001）
# - host_header: 主机头，确保正确路由
# - websocket: 启用 WebSocket 支持
# 
# 架构说明：
#   外网用户 → ngrok → proxy-server(3001) → frontend(3000)/backend(5000)
