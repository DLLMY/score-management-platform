{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "请求速率 (QPS)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(rate(flask_http_requests_total[5m]))", "legendFormat": "总 QPS" }
      ]
    },
    {
      "type": "timeseries",
      "title": "按 Endpoint 请求速率",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "expr": "sum by (endpoint) (rate(flask_http_requests_total[5m]))", "legendFormat": "{{endpoint}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 请求延迟 (秒)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(flask_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx 错误率",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 15 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(flask_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(flask_http_requests_total[5m]))",
          "legendFormat": "5xx 占比"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "未捕获异常速率 (按类型)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "expr": "sum by (exception_type) (rate(flask_exceptions_total[5m]))", "legendFormat": "{{exception_type}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "进程常驻内存",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "expr": "process_resident_memory_bytes", "legendFormat": "RSS" }
      ]
    },
    {
      "type": "timeseries",
      "title": "进程 CPU 使用率",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total[5m]) * 100", "legendFormat": "CPU%" }
      ]
    },
    {
      "type": "stat",
      "title": "应用存活 / 版本",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": {} },
        "overrides": []
      },
      "targets": [
        { "expr": "score_app_info", "legendFormat": "version {{version}}" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["score-management", "backend"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "成绩管理系统后端监控",
  "uid": "score-backend-monitor",
  "version": 1
}
