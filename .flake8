[flake8]
max-line-length = 120
exclude =
    scripts,
    tools,
    tests,
    __pycache__,
    .git,
    node_modules,
    instance,
    migrations,
    archive

# F821/F822 忽略原因：
# flake8无法正确解析中文文档字符串（docstring）中的中文字符，
# 会将中文字符串误识别为未定义的变量名。
# 例如："成绩管理模块API路由" 被错误地解析为变量名
# 这是flake8的已知限制，对于中文项目需要特殊处理。
extend-ignore = F821, F822, E203, E251, E261, C901, W503

# 允许的最大圈复杂度（CI/CD检查中使用）
max-complexity = 50
