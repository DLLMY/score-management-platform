# ================ 数据库和数据文件 ================
# SQLite 数据库（含真实业务数据，禁止入库！仅用于本地开发）
backend/instance/
*.db
*.db-journal
*.sqlite
*.sqlite3

# 备份文件（运行时生成，不上传）
backend/backups/

# 测试数据和临时导入文件
测试文档/


# ================ 前端相关 ================
# 依赖目录（不上传，通过npm install安装）
frontend/node_modules/

# 环境变量（敏感信息不上传）
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# 构建产物（不上传，通过npm run build生成）
frontend/build/

# 测试覆盖率报告
frontend/coverage/

# npm 锁文件
frontend/yarn.lock


# ================ 后端相关 ================
# 环境变量（敏感信息不上传，但.env.example可以上传）
backend/.env

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 虚拟环境（不上传，通过requirements.txt安装）
.venv/
venv/
env/

# 测试文件（仅忽略根目录临时测试脚本）
/test_*.py
/test_mqtt.py

# pytest 缓存
.pytest_cache/


# ================ 部署相关 ================
# ngrok 日志文件（运行时生成）
deploy/ngrok/*.log

# ngrok 可执行文件和配置（可上传，方便离线部署）
# authtoken 通过 "ngrok config add-authtoken" 命令配置，不存储在 ngrok.yml 中
# deploy/ngrok/ngrok.exe
# deploy/ngrok/ngrok.yml

# Redis 服务器（上传到仓库，方便离线部署）
# redis/  # 已取消忽略，允许上传

# 服务管理器日志
deploy/service_manager.log

# 部署检查脚本（可上传）
# deploy/check_deploy.py

# 压缩包（一律忽略，避免仓库体积膨胀；部署时另行分发）
*.zip
*.rar
*.7z

# 二进制可执行文件与安装包（禁止入库，避免仓库体积膨胀；部署时另行分发）
*.exe
*.msi
*.dll
*.so
*.dylib

# PM2 进程文件
.pm2/
infra/pm2.config.json

# 后端日志归档（仅忽略归档和临时文件，保留当前日志）
backend/logs/*.log.*
backend/logs/*.json.*
backend/logs/.__*.lock
backend/logs/*.json


