# 前端 .dockerignore
# 排除不需要复制到Docker镜像的文件

# 依赖目录
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 构建产物（会在Docker中重新构建）
build/
dist/

# 测试
coverage/
.nyc_output/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# 配置文件
.env.local
.env.development.local
.env.test.local
.env.production.local

# 日志
logs/
*.log

# 文档
doc/
*.md
!README.md

# 部署脚本
deploy/

# 其他
.DS_Store
Thumbs.db