# ==================== 生产环境配置 ====================
# 复制此文件为 .env 用于生产环境
# 生产环境使用安全的配置设置

# Flask 配置
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_at_least_32_characters_strong_key
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# 数据库配置 - 生产环境建议使用PostgreSQL
# DATABASE_URI=postgresql://user:password@host:5432/dbname
DATABASE_URI=sqlite:///instance/score_management.db
SQLALCHEMY_TRACK_MODIFICATIONS=false

# Redis 缓存配置 - 生产环境使用远程Redis
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password

# JWT 配置 - 生产环境必须设置至少32字节的密钥
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_at_least_32_characters_strong_jwt_key
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800
JWT_ALGORITHM=HS256

# 安全配置
CSRF_SECRET_KEY=your_csrf_secret_key_here_different_from_flask_secret
ENABLE_HTTPS=true

# 限流配置 - 生产环境严格限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_DEFAULT=1000 per hour
RATE_LIMIT_STRICT=500 per hour
RATE_LIMIT_BURST=50 per minute

# MQTT 配置 - 生产环境使用安全的MQTT Broker
MQTT_BROKER=your_mqtt_broker_host
MQTT_PORT=8883
MQTT_CLIENT_ID=score_backend_prod
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_SSL=true
MQTT_TIMEOUT=10
MQTT_KEEPALIVE=60
MQTT_TOPIC_PREFIX=score/management

# Celery 配置
CELERY_BROKER_URL=redis://your_redis_host:6379/1
CELERY_RESULT_BACKEND=redis://your_redis_host:6379/1
CELERY_WORKER_CONCURRENCY=4

# 备份配置 - 生产环境必须启用
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_COUNT=10

# CORS配置 - 生产环境只允许指定域名
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s: %(message)s
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# 性能配置
PERFORMANCE_MONITOR_ENABLED=true
SLOW_REQUEST_THRESHOLD=2.0

# NLP 配置
NLP_MODEL_PATH=models/trained/
ENABLE_BERT_MODEL=true

# 通知配置
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret
ENABLE_WECHAT_NOTIFICATION=false

# 短信通知
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=your_sms_access_key
SMS_ACCESS_KEY_SECRET=your_sms_secret
ENABLE_SMS_NOTIFICATION=false